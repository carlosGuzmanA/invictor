# Plantilla. Copia a .env y completa los valores:  cp .env.example .env
# .env está en .gitignore; este archivo NO — es la referencia del repo.
#
# Supabase Dashboard -> Project Settings -> API
#
# Los scripts de scripts/ leen este archivo y lo convierten en --dart-define;
# no se empaqueta dentro de la app.
#
# La anon key es pública por diseño (viaja al navegador de todas formas).
# La seguridad real la aplica Row Level Security en PostgreSQL.
# NUNCA pongas aquí la service_role key.

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Debe coincidir con el id del bucket que crea 0001_schema.sql (sección 15).
# No lo cambies salvo que también cambies el SQL.
STORAGE_BUCKET=inventory
