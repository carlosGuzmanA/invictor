/android/app/release

# Entorno local
.env

# Artefactos de build
/build/

# ============================================================================
# Seguridad — repositorio PÚBLICO
#
# Todo lo de aquí abajo contiene o puede contener credenciales. Antes de cada
# push conviene comprobar:  git check-ignore -v .env
# ============================================================================

# Variables de entorno, en todas sus formas
.env
.env.*
!.env.example
*.env

# Artefactos de compilación: las claves quedan DENTRO del JavaScript generado
# por --dart-define. build/web/main.dart.js contiene la URL y la anon key.
build/
/build/
web/build/

# Firma de Android. Perder el keystore impide publicar actualizaciones;
# filtrarlo permite a cualquiera firmar apps en tu nombre.
*.jks
*.keystore
android/key.properties
android/app/upload-keystore.jks
android/app/*.jks
key.properties

# Credenciales de servicios
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
service-account*.json
*serviceaccount*.json
*credentials*.json
*.pem
*.p12
*.p8
*.mobileprovision
*.cer

# Configuración local de Supabase CLI (puede guardar tokens de acceso)
supabase/.branches/
supabase/.temp/
.supabase/

# Volcados de base de datos: contienen datos reales de clientes
*.sql.gz
*.dump
dump.sql
backup*.sql

# Sistema y editores
.DS_Store
Thumbs.db
*.swo
.vscode/
!.vscode/extensions.json
.claude/

# Notas locales que no deben acabar en un repo público
NOTAS*.md
notas*.md
